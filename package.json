{
  "name": "certichain-ledger-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "contracts",
    "frontend"
  ],
  "scripts": {
    "build": "npm --workspace=frontend run build",
    "contracts:build": "npm --workspace=contracts run build",
    "contracts:test": "npm --workspace=contracts run test",
    "contracts:coverage": "npm --workspace=contracts run coverage",
    "frontend:dev": "npm --workspace=frontend run dev",
    "frontend:build": "npm --workspace=frontend run build",
    "frontend:test": "npm --workspace=frontend run test"
  },
  "devDependencies": {
    "@vercel/node": "^15.0.0"
  }
}
